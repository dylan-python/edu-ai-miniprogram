.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F7FA;
}

.chat-messages {
  flex: 1;
  padding: 20rpx;
  overflow-y: scroll;
}

.msg-wrapper {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.msg-wrapper.user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  position: relative;
}

.msg-wrapper.ai .msg-bubble {
  background: #fff;
  color: #333;
  margin-left: 16rpx;
  border-bottom-left-radius: 4rpx;
}

.msg-wrapper.user .msg-bubble {
  background: #4F8CF6;
  color: #fff;
  margin-right: 16rpx;
  border-bottom-right-radius: 4rpx;
}

.msg-time {
  font-size: 20rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.msg-wrapper.user .msg-time {
  color: rgba(255,255,255,0.7);
  text-align: right;
}

.thinking .dot-pulse {
  width: 48rpx;
  height: 24rpx;
  background: radial-gradient(circle, #4F8CF6 3rpx, transparent 3rpx) 0 0 / 16rpx 24rpx;
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0%, 100% { background-position: 0 0; }
  50% { background-position: 16rpx 0; }
}

.suggestions {
  white-space: nowrap;
  padding: 12rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.suggestion-tag {
  display: inline-block;
  background: #E8F0FE;
  color: #4F8CF6;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #F5F7FA;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #ddd;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  margin-left: 16rpx;
  border: none;
}

.send-btn.active {
  background: #4F8CF6;
}
