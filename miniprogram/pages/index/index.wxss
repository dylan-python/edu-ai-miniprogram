/* 首页样式 */
.page-index {
  padding-bottom: 40rpx;
}

/* 头部横幅 */
.header-banner {
  background: linear-gradient(135deg, #4F8CF6 0%, #6C5CE7 100%);
  padding: 60rpx 30rpx 50rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.banner-content {
  flex: 1;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 10rpx;
  display: block;
}

.banner-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: 3rpx solid rgba(255,255,255,0.3);
}

/* 分区 */
.section {
  padding: 30rpx 20rpx 10rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.btn-add {
  background: #E8F0FE;
  color: #4F8CF6;
  font-size: 24rpx;
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
  line-height: 1.8;
}

/* 学生滚动条 */
.student-scroll {
  white-space: nowrap;
  padding: 10rpx 0;
}

.student-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  padding: 20rpx 10rpx;
  margin: 0 10rpx;
  background: #fff;
  border-radius: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.student-card.active {
  background: #E8F0FE;
  border: 2rpx solid #4F8CF6;
}

.student-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #4F8CF6, #6C5CE7);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.student-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.student-grade {
  font-size: 22rpx;
  color: #999;
}

.check-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  background: #4F8CF6;
  color: #fff;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 快捷功能 */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.quick-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.quick-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 12rpx;
}

.quick-icon.checkin { background: #E8F5E9; }
.quick-icon.exam { background: #FFF3E0; }
.quick-icon.guidance { background: #E8F0FE; }
.quick-icon.history { background: #F3E5F5; }

.quick-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.quick-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 今日状态 */
.today-status {
  margin: 0 20rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-label {
  font-size: 26rpx;
  color: #666;
}

.status-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.status-summary {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #4F8CF6;
  font-weight: 500;
}

.summary-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}
